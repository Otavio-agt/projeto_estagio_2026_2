<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Painel - Agendamentos</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-neutral-950 text-neutral-100">
  <header class="max-w-4xl mx-auto px-4 py-8 flex items-center justify-between">
    <h1 class="text-2xl font-bold">Agendamentos</h1>
    <form action="/logout" method="POST">
      <button type="submit" class="text-sm text-neutral-400 hover:text-white underline">Sair</button>
    </form>
  </header>

  <main class="max-w-4xl mx-auto px-4 pb-16">
    <% if (agendamentos.length === 0) { %>
      <p class="text-neutral-400">Nenhum agendamento ainda.</p>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-neutral-700 text-neutral-400 text-sm">
              <th class="py-2 pr-4">Nome</th>
              <th class="py-2 pr-4">Email</th>
              <th class="py-2 pr-4">Estilo</th>
              <th class="py-2 pr-4">Data</th>
              <th class="py-2 pr-4">Horario</th>
              <th class="py-2 pr-4">Status</th>
            </tr>
          </thead>
          <tbody>
            <% agendamentos.forEach(a => { %>
              <tr class="border-b border-neutral-800">
                <td class="py-2 pr-4"><%= a.nome %></td>
                <td class="py-2 pr-4"><%= a.email %></td>
                <td class="py-2 pr-4"><%= a.estilo %></td>
                <td class="py-2 pr-4"><%= a.data %></td>
                <td class="py-2 pr-4"><%= a.horario %></td>
                <td class="py-2 pr-4">
                  <span class="px-2 py-1 rounded-full text-xs
                    <%= a.status === 'confirmado' ? 'bg-green-900/50 text-green-300' : '' %>
                    <%= a.status === 'pendente' ? 'bg-yellow-900/50 text-yellow-300' : '' %>
                    <%= a.status === 'cancelado' ? 'bg-red-900/50 text-red-300' : '' %>">
                    <%= a.status %>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
</body>
</html>
