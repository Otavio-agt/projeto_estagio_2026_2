<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light" />
  <title>Painel - Agendamentos</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="min-h-screen">
  <header class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-8 flex items-center justify-between gap-4 border-b border-[var(--ink)]/15">
    <span class="font-display text-2xl">Leao Barbearia</span>
    <form action="/logout" method="POST">
      <button type="submit" class="font-mono text-xs uppercase tracking-widest underline hover:text-[var(--rust)] transition">Sair</button>
    </form>
  </header>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-10 pb-16">
    <h1 class="font-display text-4xl mb-1">Agendamentos</h1>
    <p class="font-mono text-[10px] uppercase tracking-widest text-[var(--ink)]/50 mb-8">Lista de horarios, ordenada por data</p>

    <% if (agendamentos.length === 0) { %>
      <p class="font-body text-[var(--ink)]/60">Nenhum agendamento ainda.</p>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b-2 border-[var(--ink)] font-mono text-[10px] uppercase tracking-widest text-[var(--ink)]/60">
              <th class="py-2 pr-4">Nome</th>
              <th class="py-2 pr-4">Email</th>
              <th class="py-2 pr-4">Servico</th>
              <th class="py-2 pr-4">Data</th>
              <th class="py-2 pr-4">Horario</th>
              <th class="py-2 pr-4">Status</th>
              <th class="py-2 pr-4">Acoes</th>
            </tr>
          </thead>
          <tbody class="font-body text-sm">
            <% agendamentos.forEach(a => { %>
              <tr class="border-b border-[var(--ink)]/15">
                <td class="py-3 pr-4"><%= a.nome %></td>
                <td class="py-3 pr-4"><%= a.email %></td>
                <td class="py-3 pr-4"><%= a.servico %></td>
                <td class="py-3 pr-4 font-mono"><%= a.data %></td>
                <td class="py-3 pr-4 font-mono"><%= a.horario %></td>
                <td class="py-3 pr-4">
                  <span class="status-stamp <%= a.status %>"><%= a.status %></span>
                </td>
                <td class="py-3 pr-4">
                  <div class="flex flex-wrap gap-2">
                    <% if (a.status !== 'confirmado') { %>
                      <form action="/painel/agendamentos/<%= a.id %>/status" method="POST">
                        <input type="hidden" name="status" value="confirmado" />
                        <button type="submit" class="font-mono text-[10px] uppercase tracking-widest border border-[var(--sage)] text-[var(--sage)] rounded-full px-2 py-1 hover:bg-[var(--sage)] hover:text-[var(--paper)] transition">Confirmar</button>
                      </form>
                    <% } %>
                    <% if (a.status !== 'cancelado') { %>
                      <form action="/painel/agendamentos/<%= a.id %>/status" method="POST">
                        <input type="hidden" name="status" value="cancelado" />
                        <button type="submit" class="font-mono text-[10px] uppercase tracking-widest border border-[var(--rust)] text-[var(--rust)] rounded-full px-2 py-1 hover:bg-[var(--rust)] hover:text-[var(--paper)] transition">Cancelar</button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
</body>
</html>
